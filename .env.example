# ---------------------------------------------------------------------------
# MODEL PROVIDER — pick ONE and set its key. All of these except Anthropic
# have a free tier that comfortably covers this workload (~10-15 requests/day).
# ---------------------------------------------------------------------------
LLM_PROVIDER=groq

# groq       — free, fast, no credit card.   https://console.groq.com/keys
GROQ_API_KEY=

# gemini     — free tier, no card.           https://aistudio.google.com/apikey
GEMINI_API_KEY=

# openrouter — free `:free` models.          https://openrouter.ai/keys
OPENROUTER_API_KEY=

# cerebras   — free tier, no card.           https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# anthropic  — PAID, best quality (~$3-5/mo). https://console.anthropic.com
ANTHROPIC_API_KEY=

# LLM_PROVIDER=none  ->  no model at all, rule-based scoring, zero cost.

# Override the default model or batch size for your provider (optional).
LLM_MODEL=
LLM_BATCH_SIZE=

# ---------------------------------------------------------------------------
# Optional: free, instant, no credit card. Powers the economic release calendar.
# https://fredaccount.stlouisfed.org/apikeys
# ---------------------------------------------------------------------------
FRED_API_KEY=

# Which regions get a personal-relevance boost, and how big it is.
NEWSDESK_HOME_REGIONS=India,US
NEWSDESK_HOME_BOOST=12

# Cap how many stories get scored each run.
MAX_ARTICLES_TO_SCORE=140
